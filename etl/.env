STG_ROOT_PASSWORD=admin123
STG_DB_NAME=staging
STG_USER=stg_user
STG_PASSWORD=stg123
STG_HOST=staging-db
STG_PORT=3306

OLTP_HOST=host.docker.internal
OLTP_PORT=3307
OLTP_DB_NAME=amazon_clone
OLTP_USER=oltp_user
OLTP_PASSWORD=oltp123

DW_HOST=host.docker.internal
DW_PORT=3308
DW_DB_NAME=amazon_dw
DW_USER=etl_user
DW_PASSWORD=dw123

# ---- ETL SCHEDULE (cron syntax: minute hour day month weekday) ----
# Every minute (current):
CRON_SCHEDULE=* * * * *
# Every hour (switch to this by commenting the line above):
# CRON_SCHEDULE=0 * * * *
# Other examples: every 5 min = */5 * * * *   |   daily 02:00 = 0 2 * * *

RUN_ON_START=true
BATCH_SIZE=5000
LOOKBACK_MINUTES=5